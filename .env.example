# Copy to .env and adjust.

DATABASE_URL=sqlite:///./mtg.db

# Discord webhook for price alerts. Leave empty to only log alerts in the app.
DISCORD_WEBHOOK_URL=

# Background jobs
SCHEDULER_ENABLED=true
DAILY_UPDATE_HOUR=6
WISHLIST_CHECK_HOURS=6
# How often decks that follow an Archidekt link are brought up to date (0 = never automatically)
DECK_SYNC_HOURS=6
ALERT_COOLDOWN_HOURS=24

# Discord message after the daily price update when a card you own rose at least
# PRICE_RISE_PCT percent and PRICE_RISE_MIN_EUR euro compared with PRICE_RISE_DAYS days ago
# (PRICE_RISE_PCT=0 turns it off)
PRICE_RISE_PCT=25
PRICE_RISE_MIN_EUR=1
PRICE_RISE_DAYS=7

# Discord message when a card on your wishlist got at least PRICE_DROP_PCT percent and
# PRICE_DROP_MIN_EUR euro cheaper compared with PRICE_DROP_DAYS days ago
# (PRICE_DROP_PCT=0 turns it off)
PRICE_DROP_PCT=15
PRICE_DROP_MIN_EUR=0.5
PRICE_DROP_DAYS=7

# Discord message when a card you own worth at least REPRINT_MIN_EUR euro gets a new printing
# (released or announced in the last REPRINT_DAYS days); REPRINT_MIN_EUR=0 turns it off
REPRINT_MIN_EUR=5
REPRINT_DAYS=60

# The token overlay for OBS (/stream/control and /stream/overlay) keeps its board in this file;
# presets and the deck go next to it (stream-state-presets.json, stream-state-deck.json)
STREAM_STATE=stream-state.json

# Tokens you always bring along; the token suggestions of a deck leave them out (comma separated)
STANDARD_TOKENS=Clue,Copy

# Discord message when the automatic sync finds changes in a deck on Archidekt, with the new
# cards you do not have yet
DECK_CHANGE_ALERTS=true

# Daily backup of the database (SQLite only): folder, how many to keep (0 turns it off) and hour
BACKUP_DIR=backups
BACKUP_KEEP=14
BACKUP_HOUR=3

# Weekly summary on Discord (collection value, risers and fallers, games played):
# day of the week (mon, tue, ... sun; empty turns it off) and hour
WEEKLY_SUMMARY_DAY=mon
WEEKLY_SUMMARY_HOUR=9

# Rate limits (seconds between requests)
SCRYFALL_MIN_INTERVAL=0.1
# Scryfall is much stricter on name lookups and bulk requests (used by the CSV import)
SCRYFALL_SLOW_INTERVAL=0.6
CARDMARKET_MIN_INTERVAL=5
CARDMARKET_ENABLED=true
