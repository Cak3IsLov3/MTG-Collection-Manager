# Copy to .env and adjust.

DATABASE_URL=sqlite:///./mtg.db

# Discord webhook for price alerts. Leave empty to only log alerts in the app.
DISCORD_WEBHOOK_URL=

# Background jobs
SCHEDULER_ENABLED=true
DAILY_UPDATE_HOUR=6
WISHLIST_CHECK_HOURS=6
# How often decks that follow an Archidekt link are brought up to date (0 = never automatically)
DECK_SYNC_HOURS=6
ALERT_COOLDOWN_HOURS=24

# Rate limits (seconds between requests)
SCRYFALL_MIN_INTERVAL=0.1
# Scryfall is much stricter on name lookups and bulk requests (used by the CSV import)
SCRYFALL_SLOW_INTERVAL=0.6
CARDMARKET_MIN_INTERVAL=5
CARDMARKET_ENABLED=true
