# Copy to .env and adjust.

DATABASE_URL=sqlite:///./mtg.db

# Discord webhook for price alerts. Leave empty to only log alerts in the app.
DISCORD_WEBHOOK_URL=

# Background jobs
SCHEDULER_ENABLED=true
DAILY_UPDATE_HOUR=6
WISHLIST_CHECK_HOURS=6
# How often decks that follow an Archidekt link are brought up to date (0 = never automatically)
DECK_SYNC_HOURS=6
ALERT_COOLDOWN_HOURS=24

# Discord message after the daily price update when a card you own rose at least
# PRICE_RISE_PCT percent and PRICE_RISE_MIN_EUR euro compared with PRICE_RISE_DAYS days ago
# (PRICE_RISE_PCT=0 turns it off)
PRICE_RISE_PCT=25
PRICE_RISE_MIN_EUR=1
PRICE_RISE_DAYS=7

# Weekly summary on Discord (collection value, risers and fallers, games played):
# day of the week (mon, tue, ... sun; empty turns it off) and hour
WEEKLY_SUMMARY_DAY=mon
WEEKLY_SUMMARY_HOUR=9

# Rate limits (seconds between requests)
SCRYFALL_MIN_INTERVAL=0.1
# Scryfall is much stricter on name lookups and bulk requests (used by the CSV import)
SCRYFALL_SLOW_INTERVAL=0.6
CARDMARKET_MIN_INTERVAL=5
CARDMARKET_ENABLED=true
